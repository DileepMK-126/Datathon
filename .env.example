# Copy to .env and replace every value with a value from your approved secret store.
POSTGRES_PASSWORD=replace-with-a-unique-database-password
JWT_SECRET=replace-with-a-minimum-32-character-random-secret
BOOTSTRAP_ADMIN_USERNAME=sentinel-admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-admin-password

# Keep true only for the synthetic demonstration environment.
SEED_DEMO_DATA=true

# ICJS remains disabled until NCRB/NIC or the authorised state agency provides
# the approved API contract, credentials, data-sharing approval, and legal basis.
ICJS_ENABLED=false
ICJS_BASE_URL=
ICJS_TOKEN_URL=
ICJS_CLIENT_ID=
ICJS_CLIENT_SECRET=
ICJS_LEGAL_BASIS=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
